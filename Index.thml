    // =========================================================================
    // 2. تهيئة خريطة Leaflet الحقيقية (تضاريس جغرافية / قمر صناعي) بدون تسميات أجنبية
    // =========================================================================
    let map;
    let mapLayers = {};
    let activeLayerType = 'terrain';
    let routesLayerGroup;
    let markersLayerGroup;
    let markerObjectsMap = {};
    const ARABIC_DIGITS = ['١', '٢', '٣', '٤', '٥', '٦'];

    const state = {
      currentGrade: 'grade1',
      currentStep: 'step1',
      timelineMode: 'before',
      activeMarkerId: null,
      discoveredMarkers: {
        grade1: new Set(),
        grade2: new Set(),
        grade3: new Set(),
      },
      visitedTimeline: {
        grade1: false,
        grade2: false,
        grade3: false,
      },
      quizState: {
        grade1: { index: 0, score: 0, answered: false, completed: false },
        grade2: { index: 0, score: 0, answered: false, completed: false },
        grade3: { index: 0, score: 0, answered: false, completed: false },
      },
    };

    function initLeafletMap() {
      // طبقات خرائط حقيقية نظيفة تماماً من أي كتابات أجنبية
      mapLayers = {
        terrain: L.tileLayer(
          'https://server.arcgisonline.com/ArcGIS/rest/services/World_Shaded_Relief/MapServer/tile/{z}/{y}/{x}',
          {
            maxNativeZoom: 13,
            maxZoom: 16,
            attribution: 'خريطة التضاريس الجغرافية — أكاديمية المنارة التعليمية',
          }
        ),
        satellite: L.tileLayer(
          'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
          {
            maxZoom: 16,
            attribution: 'صور الأقمار الصناعية — أكاديمية المنارة التعليمية',
          }
        ),
      };

      map = L.map('realMap', {
        center: MAPS_DATABASE.grade1.center,
        zoom: MAPS_DATABASE.grade1.zoom,
        layers: [mapLayers.terrain],
        zoomControl: true,
      });

      routesLayerGroup = L.layerGroup().addTo(map);
      markersLayerGroup = L.layerGroup().addTo(map);

      // إظهار التسميات القصيرة فقط عند التكبير (Zoom >= 8) وإخفاؤها عند التصغير لمنع التداخل تماماً
      map.on('zoomend', () => {
        syncZoomLabelsVisibility();
      });

      window.addEventListener('resize', () => {
        if (map) {
          map.invalidateSize();
        }
      });
    }

    function syncZoomLabelsVisibility() {
      if (!map) return;
      const showCompactLabels = map.getZoom() >= 8;
      Object.values(markerObjectsMap).forEach((marker) => {
        if (showCompactLabels) {
          marker.openTooltip();
        } else {
          marker.closeTooltip();
        }
      });
    }

    // زر تبديل نوع الخريطة الحقيقية (تضاريس جغرافية / قمر صناعي)
    function setMapLayer(type) {
      if (!mapLayers[type] || type === activeLayerType) return;

      map.removeLayer(mapLayers[activeLayerType]);
      mapLayers[type].addTo(map);
      activeLayerType = type;

      const btnTerrain = document.getElementById('btnTerrainLayer');
      const btnSatellite = document.getElementById('btnSatelliteLayer');

      if (type === 'terrain') {
        btnTerrain.className =
          'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition bg-manaraGold text-white shadow flex items-center gap-1.5';
        btnSatellite.className =
          'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition bg-white/10 hover:bg-white/20 text-slate-100 flex items-center gap-1.5';
      } else {
        btnSatellite.className =
          'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition bg-manaraGold text-white shadow flex items-center gap-1.5';
        btnTerrain.className =
          'px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition bg-white/10 hover:bg-white/20 text-slate-100 flex items-center gap-1.5';
      }
    }

    // =========================================================================
    // 3. رسم المسارات الجغرافية والتاريخية الحقيقية والدبابيس العربية
    // =========================================================================
    function renderRoutesAndZones(gradeKey, mode) {
      routesLayerGroup.clearLayers();
      const isAfter = mode === 'after';

      if (gradeKey === 'grade1') {
        // مجرى نهر النيل الحقيقي من أسوان حتى الدلتا
        const mainNilePath = [
          [24.0889, 32.8998], // الجندل الأول بأسوان
          [25.6872, 32.6396], // طيبة (الأقصر)
          [26.1551, 32.7160], // قنا / قفط
          [27.1783, 31.1859], // أسيوط
          [29.8447, 31.2508], // منف
          [30.1800, 31.1200], // رأس الدلتا
        ];

        const rosettaBranch = [
          [30.1800, 31.1200],
          [31.4000, 30.4200],
        ];

        const damiettaBranch = [
          [30.1800, 31.1200],
          [31.4200, 31.8100],
        ];

        L.polyline(mainNilePath, {
          color: '#1D4ED8',
          weight: 4,
          opacity: 0.85,
        }).addTo(routesLayerGroup);

        L.polyline(rosettaBranch, {
          color: '#1D4ED8',
          weight: 3.5,
          opacity: 0.85,
        }).addTo(routesLayerGroup);

        L.polyline(damiettaBranch, {
          color: '#1D4ED8',
          weight: 3.5,
          opacity: 0.85,
        }).addTo(routesLayerGroup);

        if (!isAfter) {
          // قبل حفر القناة: مسار القوافل البرية عبر وادي الحمامات إلى ساحل البحر الأحمر
          const overlandWadiRoute = [
            [26.1551, 32.7160], // قفط على النيل
            [25.9833, 33.5667], // وادي الحمامات
            [26.1045, 34.2800], // ميناء القصير على البحر الأحمر
          ];

          L.polyline(overlandWadiRoute, {
            color: '#1B2A49',
            weight: 4.5,
            dashArray: '8, 6',
          }).addTo(routesLayerGroup);
        } else {
          // بعد حفر قناة سيزوستريس: مسار مائي يربط الفرع الشرقي للنيل بالبحر الأحمر عبر البحيرات المرة
          const sesostrisWaterRoute = [
            [30.4500, 31.5000], // الفرع البيلوزي الشرقي للنيل
            [30.5536, 31.7844], // وادي الطميلات
            [30.5200, 32.1800], // قناة سيزوستريس
            [30.3300, 32.3800], // البحيرات المرة
            [29.9668, 32.5498], // خليج السويس والبحر الأحمر
          ];

          L.polyline(sesostrisWaterRoute, {
            color: '#C2562B',
            weight: 5.5,
            opacity: 0.95,
          }).addTo(routesLayerGroup);
        }
      } else if (gradeKey === 'grade2') {
        // مسار قناة السويس الحقيقي من بورسعيد -> الإسماعيلية -> البحيرات المرة -> السويس
        const canalCourse = [
          [31.2653, 32.3019], // بورسعيد
          [30.8500, 32.3100], // القنطرة
          [30.5965, 32.2715], // الإسماعيلية
          [30.3300, 32.3800], // البحيرات المرة
          [29.9668, 32.5498], // السويس
        ];

        L.polyline(canalCourse, {
          color: isAfter ? '#C2562B' : '#991B1B',
          weight: 6,
          opacity: 0.95,
        }).addTo(routesLayerGroup);

        // نطاق السيطرة على إقليم القناة
        L.polygon(
          [
            [31.28, 32.14],
            [31.28, 32.46],
            [29.95, 32.68],
            [29.95, 32.35],
          ],
          {
            color: isAfter ? '#1B2A49' : '#991B1B',
            fillColor: isAfter ? '#C2562B' : '#DC2626',
            fillOpacity: 0.18,
            weight: 2.5,
            dashArray: isAfter ? null : '7, 6',
          }
        ).addTo(routesLayerGroup);
      } else if (gradeKey === 'grade3') {
        if (!isAfter) {
          // المرحلة الأولى (يوليو 1882م): محاولة التقدم من الإسكندرية وتوقفها عند دفاعات كفر الدوار وترعة المحمودية
          const blockedNorthAdvance = [
            [31.2001, 29.9187], // الإسكندرية
            [31.1338, 30.1297], // كفر الدوار
          ];

          const kafrDefenseLine = [
            [31.22, 30.08],
            [31.05, 30.19],
          ];

          L.polyline(blockedNorthAdvance, {
            color: '#DC2626',
            weight: 4.5,
            dashArray: '8, 6',
          }).addTo(routesLayerGroup);

          L.polyline(kafrDefenseLine, {
            color: '#1B2A49',
            weight: 6.5,
          }).addTo(routesLayerGroup);
        } else {
          // المرحلة الثانية (أغسطس–سبتمبر 1882م): الالتفاف عبر البحر المتوسط وقناة السويس نحو التل الكبير والقاهرة
          const easternBypassRoute = [
            [31.2001, 29.9187], // الإسكندرية
            [31.5200, 31.1000], // البحر المتوسط شمال الدلتا
            [31.2653, 32.3019], // بورسعيد
            [30.5965, 32.2715], // الإسماعيلية
            [30.5536, 31.7844], // التل الكبير
            [30.0444, 31.2357], // القاهرة
          ];

          L.polyline(easternBypassRoute, {
            color: '#C2562B',
            weight: 5,
            dashArray: '9, 5',
            opacity: 0.95,
          }).addTo(routesLayerGroup);

          L.circleMarker([30.0444, 31.2357], {
            radius: 7,
            color: '#1B2A49',
            fillColor: '#C2562B',
            fillOpacity: 1,
            weight: 2.5,
          }).addTo(routesLayerGroup);
        }
      }
    }

    function getTooltipOffsetByDir(dir) {
      if (dir === 'top') return [0, -18];
      if (dir === 'bottom') return [0, 18];
      if (dir === 'left') return [-18, 0];
      return [18, 0];
    }

    function renderMapMarkers(gradeKey) {
      markersLayerGroup.clearLayers();
      markerObjectsMap = {};
      const data = MAPS_DATABASE[gradeKey];

      data.markers.forEach((m, idx) => {
        const isDiscovered = state.discoveredMarkers[gradeKey].has(m.id);
        const isActive = state.activeMarkerId === m.id;
        const arabicNum = ARABIC_DIGITS[idx] || String(idx + 1);

        const iconHtml = `
          <div class="manara-pin-wrapper">
            <div class="manara-pin-pulse ${isDiscovered ? 'discovered' : ''}"></div>
            <div class="manara-pin-core ${isDiscovered ? 'discovered' : ''} ${isActive ? 'active-pin' : ''}">
              ${arabicNum}
            </div>
          </div>
        `;

        const customIcon = L.divIcon({
          html: iconHtml,
          className: '',
          iconSize: [36, 36],
          iconAnchor: [18, 18],
        });

        const dir = m.labelDir || 'top';
        const marker = L.marker(m.coords, { icon: customIcon })
          .bindTooltip(m.tinyLabel, {
            permanent: true,
            direction: dir,
            offset: getTooltipOffsetByDir(dir),
            className: 'manara-zoom-label',
          })
          .bindPopup(
            `<div class="space-y-1">
              <div class="font-extrabold text-manaraNavy text-sm">${arabicNum}. ${m.name}</div>
              <div class="text-xs text-slate-700">${m.curriculum}</div>
            </div>`,
            {
              autoPan: true,
              autoPanPadding: [24, 24],
              offset: [0, -10],
            }
          )
          .on('click', () => inspectMarker(m.id, true, false));

        marker.addTo(markersLayerGroup);
        markerObjectsMap[m.id] = marker;
      });

      syncZoomLabelsVisibility();
    }

    // =========================================================================
    // 4. إدارة التفاعل مع المراحل والخطوات والمعالم
    // =========================================================================
    document.addEventListener('DOMContentLoaded', () => {
      initLeafletMap();

      const toggleTipsBtn = document.getElementById('toggleTipsBtn');
      const closeTipsBtn = document.getElementById('closeTipsBtn');
      const tipsDrawer = document.getElementById('tipsDrawer');

      toggleTipsBtn.addEventListener('click', () => tipsDrawer.classList.toggle('hidden'));
      closeTipsBtn.addEventListener('click', () => tipsDrawer.classList.add('hidden'));

      document.getElementById('resetViewBtn').addEventListener('click', () => {
        const data = MAPS_DATABASE[state.currentGrade];
        map.flyTo(data.center, data.zoom, { duration: 0.85 });
      });

      document.querySelectorAll('.grade-tab').forEach((btn) => {
        btn.addEventListener('click', () => selectGrade(btn.dataset.grade));
      });

      document.querySelectorAll('.step-btn').forEach((btn) => {
        btn.addEventListener('click', () => switchStep(btn.dataset.step));
      });

      document.getElementById('timelineSlider').addEventListener('input', (e) => {
        setTimelineState(e.target.value === '1' ? 'after' : 'before', true);
      });

      selectGrade('grade1');
    });

    function selectGrade(gradeKey) {
      state.currentGrade = gradeKey;
      state.timelineMode = 'before';
      const data = MAPS_DATABASE[gradeKey];

      document.querySelectorAll('.grade-tab').forEach((btn) => {
        const isSelected = btn.dataset.grade === gradeKey;
        if (isSelected) {
          btn.classList.add('bg-manaraNavy', 'text-white', 'border-manaraGold', 'shadow-md');
          btn.classList.remove('bg-manaraBg', 'text-manaraNavy', 'border-transparent', 'hover:border-slate-300');
        } else {
          btn.classList.remove('bg-manaraNavy', 'text-white', 'border-manaraGold', 'shadow-md');
          btn.classList.add('bg-manaraBg', 'text-manaraNavy', 'border-transparent', 'hover:border-slate-300');
        }
      });

      document.getElementById('stageBadge').textContent = data.badge;
      document.getElementById('mapTitle').textContent = data.title;
      document.getElementById('mapSubtitle').textContent = data.subtitle;

      setTimeout(() => {
        map.invalidateSize();
        map.flyTo(data.center, data.zoom, { duration: 0.8 });
      }, 50);

      renderRoutesAndZones(gradeKey, 'before');
      renderMapMarkers(gradeKey);
      renderLegend();

      if (data.markers.length > 0) {
        inspectMarker(data.markers[0].id, false, false);
      }

      document.getElementById('sliderLabelBefore').textContent = data.timeline.beforeLabel;
      document.getElementById('sliderLabelAfter').textContent = data.timeline.afterLabel;
      document.getElementById('compassExplanation').textContent = data.timeline.compass;
      setTimelineState('before', false);

      renderQuiz();
      switchStep('step1');
      updateProgress();
    }

    function renderLegend() {
      const gradeKey = state.currentGrade;
      const data = MAPS_DATABASE[gradeKey];
      const legendGrid = document.getElementById('legendGrid');
      legendGrid.innerHTML = '';

      data.markers.forEach((m, idx) => {
        const isDiscovered = state.discoveredMarkers[gradeKey].has(m.id);
        const isActive = state.activeMarkerId === m.id;
        const arabicNum = ARABIC_DIGITS[idx] || String(idx + 1);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `text-right p-2.5 rounded-xl border text-xs font-bold transition flex items-center justify-between gap-2 ${
          isActive
            ? 'bg-manaraNavy/10 border-manaraGold text-manaraNavy ring-2 ring-manaraGold/40'
            : isDiscovered
            ? 'bg-manaraNavy/5 border-manaraNavy/30 text-manaraNavy'
            : 'bg-white border-slate-200 text-slate-700 hover:border-manaraGold'
        }`;
        btn.innerHTML = `
          <span class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full ${
              isDiscovered ? 'bg-manaraGold' : 'bg-manaraNavy'
            } border border-manaraGold text-white text-[12px] font-extrabold flex items-center justify-center shrink-0">
              ${arabicNum}
            </span>
            <span class="line-clamp-1">${m.name}</span>
          </span>
          <span class="text-[11px] ${isDiscovered ? 'text-emerald-700' : 'text-manaraGold'} shrink-0">
            ${isDiscovered ? '✓ كُشف' : 'استكشف'}
          </span>
        `;
        btn.addEventListener('click', () => inspectMarker(m.id, true, true));
        legendGrid.appendChild(btn);
      });

      const count = state.discoveredMarkers[gradeKey].size;
      document.getElementById('discoveredCount').textContent = `اكتشفت ${count} من ${data.markers.length} معالم`;
    }

    function inspectMarker(markerId, markDiscovered = true, flyToLocation = true) {
      const gradeKey = state.currentGrade;
      const data = MAPS_DATABASE[gradeKey];
      const markerObj = data.markers.find((m) => m.id === markerId);
      if (!markerObj) return;

      state.activeMarkerId = markerId;

      if (markDiscovered) {
        state.discoveredMarkers[gradeKey].add(markerId);
        updateProgress();
      }

      renderMapMarkers(gradeKey);
      renderLegend();

      if (flyToLocation && map) {
        map.closePopup();
        const targetZoom = Math.max(data.zoom + 1, 8);
        map.flyTo(markerObj.coords, targetZoom, { duration: 0.8 });
        if (markerObjectsMap[markerId]) {
          markerObjectsMap[markerId].openPopup();
        }
      }

      if (state.currentStep !== 'step1') {
        switchStep('step1');
      }

      const idx = data.markers.findIndex((m) => m.id === markerId);
      const arabicNum = ARABIC_DIGITS[idx] || String(idx + 1);
      document.getElementById('detailBadge').textContent = `معلم رقم (${arabicNum}) على الخريطة`;
      document.getElementById('detailCoords').textContent = `${markerObj.coords[0].toFixed(2)}° N, ${markerObj.coords[1].toFixed(2)}° E`;
      document.getElementById('detailTitle').textContent = markerObj.name;
      document.getElementById('detailCurriculum').textContent = markerObj.curriculum;
      document.getElementById('detailCompass').textContent = markerObj.compass;
    }

    function switchStep(stepKey) {
      state.currentStep = stepKey;

      document.querySelectorAll('.step-btn').forEach((btn) => {
        const isActive = btn.dataset.step === stepKey;
        if (isActive) {
          btn.classList.add('bg-manaraNavy', 'text-white', 'shadow-sm');
          btn.classList.remove('text-slate-600', 'hover:bg-slate-100');
        } else {
          btn.classList.remove('bg-manaraNavy', 'text-white', 'shadow-sm');
          btn.classList.add('text-slate-600', 'hover:bg-slate-100');
        }
      });

      document.querySelectorAll('.step-panel').forEach((panel) => panel.classList.add('hidden'));
      document.getElementById(`${stepKey}Panel`).classList.remove('hidden');

      if (stepKey === 'step2') {
        state.visitedTimeline[state.currentGrade] = true;
        updateProgress();
      }
    }

    function setTimelineState(mode, markVisited = true) {
      state.timelineMode = mode;
      const gradeKey = state.currentGrade;
      const data = MAPS_DATABASE[gradeKey];
      const info = mode === 'before' ? data.timeline.before : data.timeline.after;

      document.getElementById('timelineSlider').value = mode === 'after' ? '1' : '0';

      const btnBefore = document.getElementById('btnBefore');
      const btnAfter = document.getElementById('btnAfter');

      if (mode === 'before') {
        btnBefore.className = 'flex-1 py-2 px-2.5 rounded-lg text-xs font-extrabold bg-manaraNavy text-white shadow transition';
        btnAfter.className = 'flex-1 py-2 px-2.5 rounded-lg text-xs font-extrabold bg-white text-manaraNavy border border-slate-300 transition';
      } else {
        btnAfter.className = 'flex-1 py-2 px-2.5 rounded-lg text-xs font-extrabold bg-manaraGold text-white shadow transition';
        btnBefore.className = 'flex-1 py-2 px-2.5 rounded-lg text-xs font-extrabold bg-white text-manaraNavy border border-slate-300 transition';
      }

      document.getElementById('timelinePhaseTag').textContent = info.tag;
      document.getElementById('timelineYear').textContent = info.year;
      document.getElementById('timelineTitle').textContent = info.title;
      document.getElementById('timelineDesc').textContent = info.desc;
      document.getElementById('mapPhaseBanner').textContent = `الطور المعروض: ${info.tag}`;

      renderRoutesAndZones(gradeKey, mode);

      if (markVisited) {
        state.visitedTimeline[gradeKey] = true;
        updateProgress();
      }
    }

    // =========================================================================
    // 5. تحدي المحقق التاريخي ووسام الإنجاز
    // =========================================================================
    function renderQuiz() {
      const gradeKey = state.currentGrade;
      const data = MAPS_DATABASE[gradeKey];
      const qState = state.quizState[gradeKey];

      const questionBox = document.getElementById('quizQuestionBox');
      const badgeBox = document.getElementById('badgeResultBox');
      const feedbackBox = document.getElementById('feedbackBox');
      const nextBtn = document.getElementById('nextQuestionBtn');

      if (qState.completed) {
        questionBox.classList.add('hidden');
        badgeBox.classList.remove('hidden');
        document.getElementById('quizCounter').textContent = 'اكتمل التحدي ✓';

        const total = data.quiz.length;
        const score = qState.score;
        let rankTitle = 'محقق تاريخي خبير 🏅';
        if (score === total) {
          rankTitle = 'كبير المحققين التاريخيين (الدرجة الكاملة) 🏆';
        } else if (score === 0) {
          rankTitle = 'محقق تحت التدريب — راجع الخريطة وحاول مجدداً 🧭';
        }

        document.getElementById('badgeTitle').textContent = rankTitle;
        document.getElementById('badgeScoreText').textContent = `حصلت على ${score} من ${total} في تحليل ${data.title}`;
        document.getElementById('badgeSummaryText').textContent =
          'أحسنت! الربط بين التضاريس الجغرافية والمسارات الحقيقية هو مفتاح التفوق في الامتحان.';
        document.getElementById('nextGradeBtn').textContent = `${data.nextGradeLabel} ←`;
        return;
      }

      questionBox.classList.remove('hidden');
      badgeBox.classList.add('hidden');
      feedbackBox.classList.add('hidden');
      nextBtn.classList.add('hidden');
      qState.answered = false;

      const currentQ = data.quiz[qState.index];
      document.getElementById('quizCounter').textContent = `سؤال ${qState.index + 1} من ${data.quiz.length}`;
      document.getElementById('questionText').textContent = currentQ.question;

      const optionsContainer = document.getElementById('optionsContainer');
      optionsContainer.innerHTML = '';

      const letters = ['أ', 'ب', 'ج', 'د'];
      currentQ.options.forEach((optText, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className =
          'w-full text-right p-3 rounded-xl border-2 border-slate-200 hover:border-manaraNavy bg-manaraBg hover:bg-white text-xs sm:text-sm font-bold text-manaraNavy transition flex items-start gap-2.5';
        btn.innerHTML = `
          <span class="w-6 h-6 rounded-lg bg-manaraNavy text-white text-xs font-extrabold flex items-center justify-center shrink-0 mt-0.5">
            ${letters[idx]}
          </span>
          <span class="leading-relaxed">${optText}</span>
        `;
        btn.addEventListener('click', () => handleAnswer(idx));
        optionsContainer.appendChild(btn);
      });
    }

    function handleAnswer(selectedIdx) {
      const gradeKey = state.currentGrade;
      const data = MAPS_DATABASE[gradeKey];
      const qState = state.quizState[gradeKey];
      if (qState.answered) return;

      qState.answered = true;
      const currentQ = data.quiz[qState.index];
      const isCorrect = selectedIdx === currentQ.correct;

      if (isCorrect) {
        qState.score += 1;
      }

      const optionBtns = document.getElementById('optionsContainer').querySelectorAll('button');
      optionBtns.forEach((btn, idx) => {
        btn.disabled = true;
        btn.classList.remove('hover:border-manaraNavy', 'hover:bg-white');
        if (idx === currentQ.correct) {
          btn.classList.remove('border-slate-200', 'bg-manaraBg');
          btn.classList.add('border-emerald-600', 'bg-emerald-50', 'text-emerald-950');
        } else if (idx === selectedIdx && !isCorrect) {
          btn.classList.remove('border-slate-200', 'bg-manaraBg');
          btn.classList.add('border-rose-600', 'bg-rose-50', 'text-rose-950');
        } else {
          btn.classList.add('opacity-60');
        }
      });

      const feedbackBox = document.getElementById('feedbackBox');
      const feedbackHeader = document.getElementById('feedbackHeader');
      const feedbackHint = document.getElementById('feedbackHint');

      feedbackBox.classList.remove(
        'hidden',
        'bg-emerald-50',
        'border-emerald-300',
        'text-emerald-900',
        'bg-amber-50',
        'border-amber-300',
        'text-amber-950'
      );

      if (isCorrect) {
        feedbackBox.classList.add('bg-emerald-50', 'border', 'border-emerald-300', 'text-emerald-900');
        feedbackHeader.textContent = '✓ تحليل دقيق! إجابة صحيحة';
      } else {
        feedbackBox.classList.add('bg-amber-50', 'border', 'border-amber-300', 'text-amber-950');
        feedbackHeader.textContent = '🧭 راجع البوصلة المكانية — الإجابة الصحيحة موضحة بالأخضر';
      }
      feedbackHint.textContent = `💡 فكرة الحل: ${currentQ.hint}`;

      const nextBtn = document.getElementById('nextQuestionBtn');
      nextBtn.classList.remove('hidden');
      nextBtn.textContent =
        qState.index + 1 < data.quiz.length ? 'السؤال التالي ←' : 'عرض وسام المحقق التاريخي 🏅';
    }

    function nextQuestion() {
      const gradeKey = state.currentGrade;
      const data = MAPS_DATABASE[gradeKey];
      const qState = state.quizState[gradeKey];

      if (qState.index + 1 < data.quiz.length) {
        qState.index += 1;
      } else {
        qState.completed = true;
        updateProgress();
      }
      renderQuiz();
    }

    function resetCurrentQuiz() {
      const gradeKey = state.currentGrade;
      state.quizState[gradeKey] = { index: 0, score: 0, answered: false, completed: false };
      document.getElementById('copyToast').classList.add('hidden');
      renderQuiz();
      updateProgress();
    }

    function goToNextGrade() {
      selectGrade(MAPS_DATABASE[state.currentGrade].nextGrade);
    }

    function updateProgress() {
      const gradeKey = state.currentGrade;
      let completedSteps = 0;

      if (state.discoveredMarkers[gradeKey].size >= 2) completedSteps += 1;
      if (state.visitedTimeline[gradeKey]) completedSteps += 1;
      if (state.quizState[gradeKey].completed) completedSteps += 1;

      document.getElementById('progressText').textContent = `${completedSteps} / 3 خطوات`;
      document.getElementById('progressBar').style.width = `${(completedSteps / 3) * 100}%`;
    }

    function copyResultText() {
      const gradeKey = state.currentGrade;
      const data = MAPS_DATABASE[gradeKey];
      const qState = state.quizState[gradeKey];
      const shareText = `🏅 حصلت على وسام المحقق التاريخي في «مختبر تحليل الخرائط التفاعلي» — أكاديمية المنارة التعليمية!\n📍 المرحلة: ${data.badge}\n🗺️ الخريطة: ${data.title}\n⭐ النتيجة: ${qState.score} من ${data.quiz.length}\n#المنارة_التعليمية #هنذاكر_تاريخ_سوا`;

      const tempInput = document.createElement('textarea');
      tempInput.value = shareText;
      document.body.appendChild(tempInput);
      tempInput.select();
      try {
        document.execCommand('copy');
        document.getElementById('copyToast').classList.remove('hidden');
      } catch (err) {
        // تجاهل في حال تعذر النسخ
      }
      document.body.removeChild(tempInput);
    }
  </script>
</body>
</html>
