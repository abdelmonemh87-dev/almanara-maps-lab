<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>مختبر تحليل الخرائط التفاعلي — أكاديمية المنارة التعليمية</title>

  <!-- خطوط عربية واضحة ومريحة للقراءة -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />

  <!-- مكتبة Leaflet.js للخرائط الجغرافية وصور الأقمار الصناعية الحقيقية -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <!-- مكتبة Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            manaraNavy: '#1B2A49',
            manaraNavyDark: '#121D33',
            manaraGold: '#C2562B',
            manaraGoldLight: '#D96B3E',
            manaraBg: '#F8F9FA',
            manaraSand: '#FDFBF7',
          },
          fontFamily: {
            sans: ['Cairo', 'Tajawal', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    body {
      font-family: 'Cairo', 'Tajawal', sans-serif;
      background-color: #F8F9FA;
      color: #1B2A49;
      overflow-x: hidden;
    }

    /* حاوية الخريطة الحقيقية */
    #realMap {
      width: 100%;
      height: 390px;
      background-color: #E7E0CE;
      z-index: 1;
      font-family: 'Cairo', sans-serif;
    }

    @media (min-width: 640px) {
      #realMap {
        height: 460px;
      }
    }

    /* دبابيس الخريطة العربية النابضة */
    .manara-pin-wrapper {
      position: relative;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .manara-pin-pulse {
      position: absolute;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-color: rgba(194, 86, 43, 0.45);
      animation: pinPulse 2s infinite ease-out;
    }

    .manara-pin-pulse.discovered {
      background-color: rgba(27, 42, 73, 0.35);
    }

    .manara-pin-core {
      position: relative;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background-color: #1B2A49;
      border: 2.5px solid #C2562B;
      color: #FFFFFF;
      font-family: 'Cairo', sans-serif;
      font-weight: 900;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
      transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .manara-pin-core.discovered {
      background-color: #C2562B;
      border-color: #FFFFFF;
    }

    .manara-pin-core.active-pin {
      transform: scale(1.24);
      border-color: #FDE68A;
      box-shadow: 0 0 0 4px rgba(194, 86, 43, 0.5);
    }

    @keyframes pinPulse {
      0% { transform: scale(0.8); opacity: 0.95; }
      75% { transform: scale(1.75); opacity: 0; }
      100% { transform: scale(1.75); opacity: 0; }
    }

    /* تسميات عربية مختصرة جداً تظهر فقط عند التكبير لمنع التداخل تماماً */
    .manara-zoom-label {
      background-color: rgba(27, 42, 73, 0.92) !important;
      color: #FFFFFF !important;
      border: 1px solid #C2562B !important;
      border-radius: 6px !important;
      padding: 2px 6px !important;
      font-family: 'Cairo', sans-serif !important;
      font-weight: 700 !important;
      font-size: 10.5px !important;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25) !important;
      white-space: nowrap !important;
      direction: rtl !important;
      pointer-events: none !important;
    }

    .manara-zoom-label::before {
      display: none !important;
    }

    /* تخصيص نافذة Popup بالعربية */
    .leaflet-popup-content-wrapper {
      border-radius: 14px !important;
      border: 2px solid #1B2A49 !important;
      font-family: 'Cairo', sans-serif !important;
      direction: rtl !important;
      text-align: right !important;
    }

    .leaflet-popup-content {
      margin: 12px 14px !important;
      line-height: 1.65 !important;
    }

    /* شريط التمرير الزمني */
    input[type="range"].manara-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 10px;
      border-radius: 999px;
      background: #CBD5E1;
      outline: none;
    }

    input[type="range"].manara-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #C2562B;
      border: 3px solid #1B2A49;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    }

    input[type="range"].manara-slider::-moz-range-thumb {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #C2562B;
      border: 3px solid #1B2A49;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    }

    .fade-in {
      animation: fadeIn 0.28s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- الهيدر العلوي الإلزامي من سطرين فقط دون أي أسماء شخصية -->
  <header class="bg-manaraNavy text-white shadow-lg border-b-4 border-manaraGold">
    <div class="max-w-6xl mx-auto px-4 py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5 text-center sm:text-right">
        <!-- شعار المنارة الملاحي -->
        <div class="w-12 h-12 rounded-2xl bg-manaraGold/20 border-2 border-manaraGold flex items-center justify-center shrink-0">
          <svg class="w-7 h-7 text-manaraGold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L14 7H10L12 2Z" fill="#C2562B" />
            <path d="M9 7H15L16 21H8L9 7Z" />
            <path d="M5 21H19" stroke-linecap="round" />
            <path d="M16 5L20 3M8 5L4 3" stroke-linecap="round" />
          </svg>
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold tracking-wide text-white">
            أكاديمية المنارة التعليمية
          </h1>
          <p class="text-sm sm:text-base font-semibold text-amber-200 mt-0.5">
            المنارة في التاريخ — مختبر تحليل الخرائط التفاعلي
          </p>
        </div>
      </div>

      <!-- زر إرشادات قراءة الخريطة -->
      <button
        id="toggleTipsBtn"
        type="button"
        class="px-4 py-2.5 rounded-xl bg-manaraGold hover:bg-manaraGoldLight text-white font-bold text-xs sm:text-sm shadow transition flex items-center gap-2 shrink-0"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
        </svg>
        <span>خطوات المحقق لقراءة الخريطة</span>
      </button>
    </div>

    <!-- درج الإرشادات المنهجية -->
    <div id="tipsDrawer" class="hidden bg-manaraNavyDark border-t border-slate-700">
      <div class="max-w-6xl mx-auto px-4 py-5">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm sm:text-base font-bold text-amber-300">
            🧭 كيف تقرأ الخريطة التاريخية في الامتحان كالمحقق؟
          </h2>
          <button id="closeTipsBtn" type="button" class="text-slate-300 hover:text-white text-xs font-bold px-3 py-1.5 rounded-lg bg-slate-800">
            إغلاق ✕
          </button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="bg-slate-800/85 border border-slate-700 rounded-xl p-4">
            <div class="font-extrabold text-manaraGold text-base mb-1">1. اقرأ الرموز والاتجاهات أولاً</div>
            <p class="text-slate-200 leading-relaxed text-xs sm:text-sm">
              حدد الاتجاهات الأربعة ومفتاح الخريطة والمسارات المائية والبرية قبل قراءة الاختيارات.
            </p>
          </div>
          <div class="bg-slate-800/85 border border-slate-700 rounded-xl p-4">
            <div class="font-extrabold text-manaraGold text-base mb-1">2. اربط التضاريس بالقرار</div>
            <p class="text-slate-200 leading-relaxed text-xs sm:text-sm">
              الجنادل والأودية الصحراوية والترع والمضايق تفسر لماذا اتُخذ القرار التجاري أو العسكري في هذا الموقع.
            </p>
          </div>
          <div class="bg-slate-800/85 border border-slate-700 rounded-xl p-4">
            <div class="font-extrabold text-manaraGold text-base mb-1">3. قارن بين «قبل» و«بعد»</div>
            <p class="text-slate-200 leading-relaxed text-xs sm:text-sm">
              أي تغير في مسار التجارة أو السيادة أو خطوط الزحف على الخريطة يعكس تحولاً استراتيجياً في ميزان القوة.
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- المحتوى الرئيسي -->
  <main class="flex-grow max-w-6xl w-full mx-auto px-4 py-6 space-y-6">

    <!-- تبويبات المراحل الثانوية الثلاث -->
    <section aria-label="اختيار المرحلة الدراسية" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-2">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-2" id="gradeTabs">
        <button
          type="button"
          data-grade="grade1"
          class="grade-tab text-right p-3.5 rounded-xl border-2 transition flex flex-col justify-between"
        >
          <span class="text-xs font-bold opacity-85">الصف الأول الثانوي</span>
          <span class="text-base font-extrabold mt-0.5">وادي النيل والدلتا والبحر الأحمر</span>
          <span class="text-xs mt-1 opacity-90">الجندل الأول • الدلتا • وادي الحمامات • قناة سيزوستريس</span>
        </button>

        <button
          type="button"
          data-grade="grade2"
          class="grade-tab text-right p-3.5 rounded-xl border-2 transition flex flex-col justify-between"
        >
          <span class="text-xs font-bold opacity-85">الصف الثاني الثانوي — البكالوريا المصرية</span>
          <span class="text-base font-extrabold mt-0.5">إقليم قناة السويس (التاريخ الوطني)</span>
          <span class="text-xs mt-1 opacity-90">بورسعيد • الإسماعيلية والبحيرات المرة • السويس</span>
        </button>

        <button
          type="button"
          data-grade="grade3"
          class="grade-tab text-right p-3.5 rounded-xl border-2 transition flex flex-col justify-between"
        >
          <span class="text-xs font-bold opacity-85">الصف الثالث الثانوي (الفصل الثالث)</span>
          <span class="text-base font-extrabold mt-0.5">مسرح عمليات صيف 1882م (الثورة العرابية)</span>
          <span class="text-xs mt-1 opacity-90">الإسكندرية • كفر الدوار • قناة السويس • التل الكبير</span>
        </button>
      </div>
    </section>

    <!-- بطاقة تعريف الخريطة الحالية ومؤشر التقدم -->
    <section class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-manaraNavy/10 text-manaraNavy text-xs font-bold mb-2">
          <span id="stageBadge">الصف الأول الثانوي — تاريخ وحضارة مصر والعالم القديم</span>
        </div>
        <h2 id="mapTitle" class="text-lg sm:text-2xl font-extrabold text-manaraNavy">
          خريطة وادي النيل والدلتا والبحر الأحمر وقناة سيزوستريس
        </h2>
        <p id="mapSubtitle" class="text-xs sm:text-sm text-slate-600 mt-1">
          استكشف الخريطة الحقيقية وبدّل بين التضاريس الجغرافية والقمر الصناعي لتفهم كيف ربط المصري القديم النيل بالبحر الأحمر.
        </p>
      </div>

      <!-- مؤشر التقدم -->
      <div class="bg-manaraBg border border-slate-200 rounded-xl px-4 py-3 shrink-0 w-full md:w-auto">
        <div class="text-xs font-bold text-slate-500">تقدمك في هذه الخريطة:</div>
        <div class="flex items-center gap-3 mt-1">
          <div class="text-base sm:text-lg font-extrabold text-manaraNavy" id="progressText">0 / 3 خطوات</div>
          <div class="w-24 h-2.5 bg-slate-200 rounded-full overflow-hidden">
            <div id="progressBar" class="h-full bg-manaraGold transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- منطقة التفاعل الرئيسية: الخريطة الحقيقية + خطوات التحليل الثلاث -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- العمود الأيمن (7 أعمدة): خريطة Leaflet الحقيقية وأزرار التبديل ومفتاح الخريطة -->
      <div class="lg:col-span-7 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

        <!-- شريط التحكم بنوع الخريطة الحقيقية وإعادة ضبط الإطار -->
        <div class="bg-manaraNavy text-white px-3.5 py-3 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2" role="group" aria-label="تبديل نوع الخريطة الحقيقية">
            <button
              type="button"
              id="btnTerrainLayer"
              onclick="setMapLayer('terrain')"
              class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition bg-manaraGold text-white shadow flex items-center gap-1.5"
            >
              <span>🏔️ تضاريس جغرافية</span>
            </button>
            <button
              type="button"
              id="btnSatelliteLayer"
              onclick="setMapLayer('satellite')"
              class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition bg-white/10 hover:bg-white/20 text-slate-100 flex items-center gap-1.5"
            >
              <span>🛰️ قمر صناعي</span>
            </button>
          </div>

          <button
            type="button"
            id="resetViewBtn"
            class="px-3 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-amber-200 text-xs font-extrabold transition flex items-center gap-1.5"
          >
            <span>🧭 إعادة ضبط الإطار</span>
          </button>
        </div>

        <!-- حاوية خريطة Leaflet الحقيقية -->
        <div class="relative">
          <div id="realMap"></div>

          <!-- مؤشر الشمال العربي -->
          <div class="pointer-events-none absolute top-3 left-3 z-[500] bg-manaraNavy/92 text-white border border-manaraGold rounded-xl px-2.5 py-1.5 shadow-md flex items-center gap-1.5 text-xs font-extrabold">
            <span class="text-manaraGold text-sm">▲</span>
            <span>شمال</span>
          </div>

          <!-- شارة الطور الزمني المعروض على الخريطة -->
          <div id="mapPhaseBanner" class="pointer-events-none absolute bottom-3 right-3 z-[500] bg-manaraNavy/92 text-amber-200 border border-manaraGold rounded-xl px-3 py-1.5 shadow-md text-xs font-extrabold">
            الطور المعروض: الوضع قبل التحول
          </div>
        </div>

        <!-- مفتاح الخريطة التفاعلي -->
        <div class="p-4 bg-manaraBg border-t border-slate-200">
          <div class="flex items-center justify-between mb-2.5">
            <h3 class="text-xs sm:text-sm font-extrabold text-manaraNavy">
              🗝️ مفتاح الخريطة التفاعلي (اضغط على الرقم للانتقال للمعلم دون ازدحام):
            </h3>
            <span id="discoveredCount" class="text-xs font-bold text-manaraGold">اكتشفت 0 من 4 معالم</span>
          </div>
          <div id="legendGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
        </div>
      </div>

      <!-- العمود الأيسر (5 أعمدة): خطوات المحقق الثلاث + نافذة بوصلة المكان + التحدي -->
      <div class="lg:col-span-5 space-y-4">

        <!-- أزرار التنقل بين الخطوات الثلاث -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-2 grid grid-cols-3 gap-1.5">
          <button
            type="button"
            data-step="step1"
            class="step-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-extrabold text-center transition"
          >
            1. فك الشفرة
          </button>
          <button
            type="button"
            data-step="step2"
            class="step-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-extrabold text-center transition"
          >
            2. قبل وبعد
          </button>
          <button
            type="button"
            data-step="step3"
            class="step-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-extrabold text-center transition"
          >
            3. تحدي المحقق
          </button>
        </div>

        <!-- لوحة الخطوة النشطة -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 min-h-[430px] flex flex-col justify-between">

          <!-- الخطوة 1: فك الشفرة المكانية -->
          <div id="step1Panel" class="step-panel fade-in space-y-4">
            <div class="border-b border-slate-100 pb-3">
              <span class="text-xs font-bold text-manaraGold">الخطوة الأولى — القراءة المكانية الحقيقية</span>
              <h3 class="text-base sm:text-lg font-extrabold text-manaraNavy mt-0.5">
                دلالة المعلم في المنهج وبوصلته الجغرافية
              </h3>
              <p class="text-xs text-slate-500 mt-1">
                اضغط على أي رقم فوق الخريطة أو في المفتاح لتكبير موقعه وقراءة تحليله الجغرافي والتاريخي.
              </p>
            </div>

            <!-- بطاقة تفاصيل المعلم المختار -->
            <div class="bg-manaraSand border-r-4 border-manaraGold rounded-xl p-4 space-y-3 border border-amber-900/10">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span id="detailBadge" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-manaraNavy text-white">
                  معلم رقم (1)
                </span>
                <span id="detailCoords" class="text-[11px] font-bold text-slate-500" dir="ltr">
                  24.09° N, 32.90° E
                </span>
              </div>

              <h4 id="detailTitle" class="text-base sm:text-lg font-extrabold text-manaraNavy">
                الجندل الأول بأسوان
              </h4>

              <div>
                <div class="text-xs font-extrabold text-manaraGold mb-1">📘 دلالة المكان في المنهج:</div>
                <p id="detailCurriculum" class="text-xs sm:text-sm text-slate-700 leading-relaxed"></p>
              </div>

              <div class="pt-2.5 border-t border-slate-200/80">
                <div class="text-xs font-extrabold text-manaraNavy mb-1">🧭 بوصلة المكان (التفسير الجغرافي):</div>
                <p id="detailCompass" class="text-xs sm:text-sm text-slate-700 leading-relaxed"></p>
              </div>
            </div>

            <div class="flex justify-end pt-1">
              <button
                type="button"
                onclick="switchStep('step2')"
                class="px-4 py-2.5 rounded-xl bg-manaraNavy hover:bg-manaraNavyDark text-white text-xs sm:text-sm font-bold transition flex items-center gap-2"
              >
                <span>التالي: المقارنة الزمنية (قبل وبعد)</span>
                <span>←</span>
              </button>
            </div>
          </div>

          <!-- الخطوة 2: المقارنة الزمنية + نافذة بوصلة المكان -->
          <div id="step2Panel" class="step-panel hidden fade-in space-y-4">
            <div class="border-b border-slate-100 pb-3">
              <span class="text-xs font-bold text-manaraGold">الخطوة الثانية — التحول الزمني على الخريطة</span>
              <h3 class="text-base sm:text-lg font-extrabold text-manaraNavy mt-0.5">
                المقارنة بين «قبل التحول» و«بعد التحول»
              </h3>
              <p class="text-xs text-slate-500 mt-1">
                بدّل بين الوضعين لمشاهدة تغيّر المسارات ومناطق السيطرة مباشرة على الخريطة الحقيقية.
              </p>
            </div>

            <!-- أزرار وشريط التبديل -->
            <div class="bg-manaraBg border border-slate-200 rounded-xl p-3.5 space-y-3">
              <div class="flex items-center justify-between gap-2">
                <button
                  type="button"
                  id="btnBefore"
                  onclick="setTimelineState('before')"
                  class="flex-1 py-2 px-2.5 rounded-lg text-xs font-extrabold transition"
                >
                  قبل التحول
                </button>
                <button
                  type="button"
                  id="btnAfter"
                  onclick="setTimelineState('after')"
                  class="flex-1 py-2 px-2.5 rounded-lg text-xs font-extrabold transition"
                >
                  بعد التحول
                </button>
              </div>

              <div class="px-1">
                <input
                  type="range"
                  id="timelineSlider"
                  min="0"
                  max="1"
                  step="1"
                  value="0"
                  class="manara-slider"
                  aria-label="شريط المقارنة الزمنية"
                />
                <div class="flex justify-between text-[11px] font-bold text-slate-500 mt-1">
                  <span id="sliderLabelBefore">قبل التحول</span>
                  <span id="sliderLabelAfter">بعد التحول</span>
                </div>
              </div>
            </div>

            <!-- بطاقة شرح الطور الحالي -->
            <div class="bg-white border-2 border-manaraNavy/15 rounded-xl p-4 space-y-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span id="timelinePhaseTag" class="text-xs font-extrabold px-2.5 py-1 rounded-lg bg-amber-100 text-manaraGold"></span>
                <span id="timelineYear" class="text-xs font-extrabold text-manaraNavy"></span>
              </div>
              <h4 id="timelineTitle" class="text-sm sm:text-base font-extrabold text-manaraNavy"></h4>
              <p id="timelineDesc" class="text-xs sm:text-sm text-slate-700 leading-relaxed"></p>
            </div>

            <!-- نافذة بوصلة المكان -->
            <div class="bg-manaraNavy text-white rounded-xl p-3.5 space-y-1.5 border-r-4 border-manaraGold">
              <div class="text-xs font-extrabold text-amber-300">
                🧭 نافذة [بوصلة المكان]:
              </div>
              <p id="compassExplanation" class="text-xs sm:text-sm text-slate-100 leading-relaxed"></p>
            </div>

            <div class="flex items-center justify-between pt-1">
              <button
                type="button"
                onclick="switchStep('step1')"
                class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-manaraNavy text-xs font-bold transition"
              >
                → السابق
              </button>
              <button
                type="button"
                onclick="switchStep('step3')"
                class="px-4 py-2.5 rounded-xl bg-manaraGold hover:bg-manaraGoldLight text-white text-xs sm:text-sm font-bold transition flex items-center gap-2"
              >
                <span>التالي: تحدي المحقق التاريخي</span>
                <span>←</span>
              </button>
            </div>
          </div>

          <!-- الخطوة 3: تحدي المحقق التاريخي -->
          <div id="step3Panel" class="step-panel hidden fade-in space-y-4">
            <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-manaraGold">الخطوة الثالثة — قياس نواتج التعلم</span>
                <h3 class="text-base sm:text-lg font-extrabold text-manaraNavy mt-0.5">
                  تحدي المحقق التاريخي
                </h3>
              </div>
              <span id="quizCounter" class="text-xs font-extrabold px-3 py-1 rounded-full bg-manaraNavy text-white">
                سؤال 1 من 3
              </span>
            </div>

            <!-- حاوية الأسئلة -->
            <div id="quizQuestionBox" class="space-y-3">
              <p id="questionText" class="text-sm sm:text-base font-bold text-manaraNavy leading-relaxed"></p>
              <div id="optionsContainer" class="space-y-2"></div>

              <!-- التغذية الراجعة وفكرة الحل -->
              <div id="feedbackBox" class="hidden rounded-xl p-3.5 text-sm space-y-1.5">
                <div id="feedbackHeader" class="font-extrabold"></div>
                <p id="feedbackHint" class="text-xs sm:text-sm leading-relaxed"></p>
              </div>

              <div class="flex items-center justify-between pt-2">
                <button
                  type="button"
                  onclick="switchStep('step2')"
                  class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-manaraNavy text-xs font-bold transition"
                >
                  → مراجعة الخريطة
                </button>
                <button
                  type="button"
                  id="nextQuestionBtn"
                  onclick="nextQuestion()"
                  class="hidden px-4 py-2 rounded-xl bg-manaraNavy hover:bg-manaraNavyDark text-white text-xs sm:text-sm font-bold transition"
                >
                  السؤال التالي ←
                </button>
              </div>
            </div>

            <!-- وسام المحقق التاريخي عند إتمام الأسئلة -->
            <div id="badgeResultBox" class="hidden text-center bg-gradient-to-b from-manaraNavy to-manaraNavyDark text-white rounded-2xl p-5 space-y-3 border-2 border-manaraGold">
              <div class="w-16 h-16 mx-auto rounded-full bg-manaraGold/20 border-2 border-manaraGold flex items-center justify-center text-3xl">
                🏅
              </div>
              <div class="text-xs font-bold text-amber-300">
                وسام المحقق التاريخي — أكاديمية المنارة التعليمية
              </div>
              <h4 id="badgeTitle" class="text-xl font-extrabold text-white">
                محقق تاريخي خبير
              </h4>
              <p id="badgeScoreText" class="text-sm text-slate-200"></p>
              <p id="badgeSummaryText" class="text-xs text-amber-200 leading-relaxed"></p>

              <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
                <button
                  type="button"
                  onclick="copyResultText()"
                  class="px-4 py-2 rounded-xl bg-manaraGold hover:bg-manaraGoldLight text-white text-xs sm:text-sm font-bold transition"
                >
                  📋 نسخ النتيجة للمشاركة
                </button>
                <button
                  type="button"
                  id="nextGradeBtn"
                  onclick="goToNextGrade()"
                  class="px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs sm:text-sm font-bold transition"
                >
                  المرحلة التالية ←
                </button>
                <button
                  type="button"
                  onclick="resetCurrentQuiz()"
                  class="px-3 py-2 rounded-xl bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-bold transition"
                >
                  إعادة التحدي
                </button>
              </div>
              <div id="copyToast" class="hidden text-xs font-bold text-emerald-300 pt-1">
                ✓ تم نسخ بطاقة وسامك بنجاح!
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>

  <!-- الفوتر السفلي الثابت والمعتمد -->
  <footer class="bg-manaraNavy text-white border-t-4 border-manaraGold mt-10">
    <div class="max-w-6xl mx-auto px-4 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-right">
      <div class="font-extrabold text-base sm:text-lg tracking-wide text-amber-300">
        المنارة التعليمية / هنذاكر تاريخ سوا / واتس 01097083710
      </div>
      <div class="text-xs text-slate-300">
        مختبر تحليل الخرائط التفاعلي — أكاديمية المنارة التعليمية
      </div>
    </div>
  </footer>

